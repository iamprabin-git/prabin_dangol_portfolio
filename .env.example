ADMIN_PASSWORD="change-me-before-going-live"
AUTH_SECRET="generate-a-long-random-string"
# Optional. If set, forgot-password must use this address instead of the public site email.
# ADMIN_EMAIL="you@example.com"

# Added automatically when you create a Neon Postgres database in the Vercel dashboard.
# Storage → Create Database → Neon. Needed so admin saves persist on Vercel.
# DATABASE_URL=""
# POSTGRES_URL=""

# Cloudinary — images upload here; Neon stores only the resulting URL.
# Copy the API environment variable from https://console.cloudinary.com/app/settings/api-keys
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
